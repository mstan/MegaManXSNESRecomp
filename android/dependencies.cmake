# All third-party sources are hash-pinned by sources.json. No host libraries
# are discovered during the NDK build.
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set_property(GLOBAL PROPERTY JOB_POOLS compile=2 link=1)
set(CMAKE_JOB_POOL_COMPILE compile)
set(CMAKE_JOB_POOL_LINK link)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(SKIP_INSTALL_ALL ON CACHE BOOL "" FORCE)
set(dep "${CMAKE_CURRENT_LIST_DIR}/external")
if(NOT EXISTS "${dep}/SDL/CMakeLists.txt")
    message(FATAL_ERROR "Run python android/tools/fetch_sources.py first")
endif()
set(SDL_SHARED ON CACHE BOOL "" FORCE)
set(SDL_STATIC OFF CACHE BOOL "" FORCE)
set(SDL_TEST OFF CACHE BOOL "" FORCE)
add_subdirectory("${dep}/SDL" "${CMAKE_BINARY_DIR}/SDL" EXCLUDE_FROM_ALL)
set(ZLIB_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
add_subdirectory("${dep}/zlib" "${CMAKE_BINARY_DIR}/zlib" EXCLUDE_FROM_ALL)
set(ZLIB_LIBRARY "${CMAKE_BINARY_DIR}/zlib/libz.a" CACHE FILEPATH "" FORCE)
if(NOT TARGET ZLIB::ZLIB)
    add_library(ZLIB::ZLIB ALIAS zlibstatic)
endif()
set(ZLIB_INCLUDE_DIR "${dep}/zlib;${CMAKE_BINARY_DIR}/zlib" CACHE STRING "" FORCE)
set(PNG_SHARED OFF CACHE BOOL "" FORCE)
set(PNG_TESTS OFF CACHE BOOL "" FORCE)
set(PNG_TOOLS OFF CACHE BOOL "" FORCE)
add_subdirectory("${dep}/libpng" "${CMAKE_BINARY_DIR}/libpng" EXCLUDE_FROM_ALL)
if(NOT TARGET PNG::PNG)
    add_library(PNG::PNG ALIAS png_static)
endif()
foreach(option CATALOG DEBUG DOCB FTP HTTP HTML ICONV ICU ISO8859X LEGACY LZMA MODULES PROGRAMS PYTHON READLINE TESTS THREAD_ALLOC TREE UNICODE VALID WRITER XINCLUDE XPATH XPTR ZLIB)
    set(LIBXML2_WITH_${option} OFF CACHE BOOL "" FORCE)
endforeach()
set(LIBXML2_WITH_TREE ON CACHE BOOL "" FORCE)
set(LIBXML2_WITH_SAX1 ON CACHE BOOL "" FORCE)
set(LIBXML2_WITH_OUTPUT ON CACHE BOOL "" FORCE)
add_subdirectory("${dep}/libxml2" "${CMAKE_BINARY_DIR}/libxml2" EXCLUDE_FROM_ALL)
add_library(megamanx_gif STATIC "${dep}/giflib/dgif_lib.c" "${dep}/giflib/egif_lib.c"
    "${dep}/giflib/gifalloc.c" "${dep}/giflib/gif_err.c" "${dep}/giflib/gif_hash.c"
    "${dep}/giflib/openbsd-reallocarray.c")
target_include_directories(megamanx_gif PUBLIC "${dep}/giflib")
set(GIF_LIBRARY megamanx_gif)
set(RAPIDJSON_INCLUDE_DIR "${dep}/rapidjson/include" CACHE PATH "" FORCE)
set(SNESRECOMP_RAPIDJSON_INCLUDE_DIR "${RAPIDJSON_INCLUDE_DIR}" CACHE PATH "" FORCE)
foreach(option TEST TAR CPIO CAT UNZIP INSTALL ACL XATTR BZip2 LZMA ZSTD LZ4 OPENSSL MBEDTLS NETTLE LIBB2 XML2 EXPAT PCREPOSIX PCRE2POSIX CNG LIBXML2)
    set(ENABLE_${option} OFF CACHE BOOL "" FORCE)
endforeach()
set(ENABLE_ZLIB ON CACHE BOOL "" FORCE)
add_subdirectory("${dep}/libarchive" "${CMAKE_BINARY_DIR}/libarchive" EXCLUDE_FROM_ALL)
add_library(LibArchive::LibArchive ALIAS archive_static)
